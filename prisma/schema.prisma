generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
}

enum GradingScale {
  PERCENTAGE
  LETTER
  PASS_FAIL
}

enum MarkStatus {
  GRADED
  EXEMPT
  ABSENT
  DRAFT
  PUBLISHED
}

enum AcademicSessionStatus {
  ACTIVE
  ARCHIVED
}

enum AcademicRecordStatus {
  DRAFT
  PUBLISHED
  FINALIZED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  COMPLETED
  INACTIVE
}

enum RiskLevel {
  HIGH
  MODERATE
  LOW
}

enum RiskFlagStatus {
  PENDING
  ACKNOWLEDGED
  DISMISSED
}

// ============================================================
// CORE USER MODELS
// ============================================================

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String
  role                Role     @default(STUDENT)
  name                String?
  mustChangePassword  Boolean  @default(false)
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  teacher           Teacher?
  student           Student?
  parent            Parent?
  announcements     Announcement[]
  activityLogs      ActivityLog[] @relation("UserActivityLogs")
  actorLogs         ActivityLog[] @relation("ActorActivityLogs")
  alerts              Alert[]
  alertRecipients     AlertRecipient[]
  alertAcknowledgments AlertAcknowledgment[]
  riskFlagsReviewed   StudentRiskFlag[]
}

model Teacher {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes          Class[]
  subjects         Subject[]
  marksGiven       Mark[]
  attendance       Attendance[]
  learningChapters LearningChapter[]

  classTeacherAssignments ClassTeacherAssignment[]
  teachingAssignments     TeachingAssignment[]
}

model Student {
  id         String        @id @default(uuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId    String?
  class      Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  rollNumber String?
  status     StudentStatus @default(ACTIVE)

  marks           Mark[]
  attendance      Attendance[]
  academicRecords StudentAcademicRecord[]
  enrollments     StudentEnrollment[]
  riskFlags       StudentRiskFlag[]
  parents         ParentStudent[]

  @@index([classId])
  @@index([status])
}

model Class {
  id        String   @id @default(uuid())
  name      String   @unique
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  students         Student[]
  subjects         Subject[]
  attendance       Attendance[]
  academicRecords  StudentAcademicRecord[]
  enrollments      StudentEnrollment[]
  learningChapters LearningChapter[]
  riskFlags        StudentRiskFlag[]

  classTeacherAssignments ClassTeacherAssignment[]
  teachingAssignments     TeachingAssignment[]

  @@index([teacherId])
}

model Subject {
  id           String       @id @default(uuid())
  name         String       @unique
  code         String       @unique
  gradingScale GradingScale @default(PERCENTAGE)
  teacherId    String?
  teacher      Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  classes          Class[]
  marks            Mark[]
  attendance       Attendance[]
  learningChapters LearningChapter[]

  teachingAssignments TeachingAssignment[]

  @@index([teacherId])
}

// ============================================================
// MARKS
// ============================================================

model Mark {
  id       String     @id @default(uuid())
  score    Float?
  maxScore Float      @default(100)
  examType String
  status   MarkStatus @default(GRADED)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, examType, academicSessionId])
  @@index([studentId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([academicSessionId])
}

// ============================================================
// SCHOOL SETTINGS
// ============================================================

model SchoolSettings {
  id            String @id @default("default")
  schoolName    String @default("EduManage Academy")
  schoolAddress String @default("123 Education Lane, Learning City")
  contactNumber String @default("+1 234 567 8900")
  principalName String @default("Dr. Jane Doe")
  email         String @default("contact@edumanage.com")

  activeSessionId String?
  activeSession   AcademicSession? @relation(fields: [activeSessionId], references: [id])

  updatedAt DateTime @updatedAt
}

// ============================================================
// ACADEMIC SESSIONS
// ============================================================

model AcademicSession {
  id        String                @id @default(uuid())
  name      String                @unique
  startDate DateTime
  endDate   DateTime
  status    AcademicSessionStatus @default(ACTIVE)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  settings         SchoolSettings[]
  enrollments      StudentEnrollment[]
  marks            Mark[]
  attendance       Attendance[]
  academicRecords  StudentAcademicRecord[]
  learningChapters LearningChapter[]
  riskFlags        StudentRiskFlag[]

  classTeacherAssignments ClassTeacherAssignment[]
  teachingAssignments     TeachingAssignment[]
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id      String           @id @default(uuid())
  date    DateTime
  status  AttendanceStatus
  remarks String?

  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date, subjectId])
  @@unique([studentId, date], name: "studentId_date")
  @@index([studentId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([academicSessionId])
}

// ============================================================
// ENROLLMENT
// ============================================================

model StudentEnrollment {
  id                String           @id @default(uuid())
  studentId         String
  classId           String
  academicSessionId String
  status            EnrollmentStatus @default(ACTIVE)

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  academicRecords StudentAcademicRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, academicSessionId, status])
  @@index([classId, academicSessionId, status])
}

// ============================================================
// ACADEMIC RECORDS
// ============================================================

model StudentAcademicRecord {
  id                String @id @default(uuid())
  studentId         String
  classId           String
  academicSessionId String

  academicSession AcademicSession    @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  enrollmentId    String?
  enrollment      StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  teacherRemarks   String?
  principalRemarks String?

  finalPercentage      Float?
  finalGrade           String?
  attendancePercentage Float?
  failedSubjectCount   Int?

  status      AcademicRecordStatus @default(DRAFT)
  publishedAt DateTime?
  finalizedAt DateTime?

  verificationCode String?   @unique
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  revokedReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicSessionId])
  @@index([studentId])
  @@index([classId])
  @@index([academicSessionId])
}

// ============================================================
// ANNOUNCEMENTS & LOGS
// ============================================================

model Announcement {
  id            String    @id @default(uuid())
  title         String
  content       String
  targetRoles   String
  targetClasses String?
  priority      String    @default("NORMAL")
  expiresAt     DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String   @default("")
  user         User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)
  actionType   String   @default("GENERAL")
  targetEntity String   @default("SYSTEM")
  targetId     String   @default("")
  oldData      String?
  newData      String?

  // Preserved fields for legacy logging compatibility
  action     String?
  entityType String?
  entityId   String?
  details    String?
  actorId    String?
  actor      User?    @relation("ActorActivityLogs", fields: [actorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([actorId])
}

// ============================================================
// ASSIGNMENT MODELS
// ============================================================

model ClassTeacherAssignment {
  id                String          @id @default(uuid())
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId           String
  class             Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  isActive   Boolean   @default(true)
  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, academicSessionId, isActive])
  @@index([teacherId, academicSessionId, isActive])
}

model TeachingAssignment {
  id                String          @id @default(uuid())
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId           String
  class             Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  startDate  DateTime  @default(now())
  endDate    DateTime?
  isActive   Boolean   @default(true)
  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId, classId, academicSessionId, isActive])
  @@index([teacherId, academicSessionId, isActive])
  @@index([classId, academicSessionId, isActive])
}

// ============================================================
// LEARNING HUB
// ============================================================

model LearningChapter {
  id          String        @id @default(uuid())
  title       String
  description String?
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)

  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId           String?
  class             Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  topics LearningTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([academicSessionId, subjectId, classId])
  @@index([teacherId])
}

model LearningTopic {
  id          String        @id @default(uuid())
  title       String
  description String?
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)

  chapterId String
  chapter   LearningChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  pdfs        LearningPdf[]
  videos      LearningVideo[]
  explanation LearningExplanation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([chapterId])
}

model LearningPdf {
  id          String        @id @default(uuid())
  title       String
  description String?
  storagePath String
  fileName    String
  fileSize    Int
  mimeType    String
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)

  topicId String
  topic   LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId])
}

model LearningVideo {
  id           String        @id @default(uuid())
  title        String
  description  String?
  storagePath  String
  fileName     String?
  thumbnailUrl String?
  order        Int           @default(0)
  status       ContentStatus @default(DRAFT)

  topicId String
  topic   LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId])
}

model LearningExplanation {
  id      String        @id @default(uuid())
  content String
  status  ContentStatus @default(DRAFT)

  topicId String        @unique
  topic   LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  createdBy   String?
  updatedBy   String?
}

// ============================================================
// ALERTS
// ============================================================

enum AlertPriority {
  INFO
  NOTICE
  WARNING
  URGENT
}

enum AlertStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
}

model Alert {
  id                      String        @id @default(uuid())
  title                   String
  message                 String
  priority                AlertPriority @default(INFO)
  status                  AlertStatus   @default(PUBLISHED)
  requiresAcknowledgement Boolean       @default(false)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  targetType String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  expiresAt   DateTime?

  recipients      AlertRecipient[]
  acknowledgments AlertAcknowledgment[]

  @@index([creatorId])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model AlertRecipient {
  id String @id @default(uuid())

  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  readAt         DateTime?
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([alertId, userId])
  @@index([userId, readAt])
}

model AlertAcknowledgment {
  id String @id @default(uuid())

  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  acknowledgedAt DateTime @default(now())

  @@unique([alertId, userId])
  @@index([alertId])
  @@index([userId])
}

// ============================================================
// AT-RISK STUDENT FLAGS
// ============================================================

model StudentRiskFlag {
  id                String         @id @default(uuid())
  studentId         String
  classId           String
  academicSessionId String
  riskLevel         RiskLevel
  riskScore         Float
  reasons           String
  ruleVersion       String         @default("AT_RISK_RULE_V1.0")
  status            RiskFlagStatus @default(PENDING)
  reviewNote        String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  reviewedBy      User?           @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([studentId, academicSessionId, status])
  @@index([classId, academicSessionId, status])
  @@index([reviewedById])
}

// ============================================================
// PARENT PORTAL
// ============================================================

model Parent {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children ParentStudent[]
}

model ParentStudent {
  id               String   @id @default(uuid())
  parentId         String
  studentId        String
  relationship     String   @default("Parent")
  isPrimaryContact Boolean  @default(true)
  createdAt        DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

